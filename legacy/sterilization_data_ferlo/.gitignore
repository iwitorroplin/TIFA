# data/ (544 MB, los 80+80 CSV de origen de F1/F2) y database/ferlo.db
# (2,9 GB, la referencia congelada de la Fase 0 -ver
# tests/ferlo/test_normalizacion_congelada.py-) se quedan en el disco local,
# no en git: GitHub rechaza un fichero de mas de 100 MB, y aunque no lo
# hiciera, no tiene sentido versionar unos datos que ya estan en la maquina
# de quien los necesite.
data/
database/*.db
database/*.db-shm
database/*.db-wal
